# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Local AI agent/tooling metadata
/.agents/
/.claude/
/.windsurf/
/skills-lock.json
.omx-state-locks/
.omx-state-locks.identity.json
.codex/*
!.codex/agents/
!.codex/agents/**
!.codex/skills/
!.codex/skills/**
.codex/skills/.system/**
!.codex/prompts/
!.codex/prompts/**
.omx/

# Preserved local nested copy; canonical app lives at repository root.
/bodybuilding-coach-app/

# Browser evidence may contain sensitive session data; never commit it.
/playwright-report/
/test-results/
/blob-report/
