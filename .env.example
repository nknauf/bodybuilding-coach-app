# Neon: pooled URL for Vercel runtime, direct URL for Prisma Migrate.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Preferred current Clerk name. CLERK_WEBHOOK_SECRET remains a compatibility
# alias for existing deployments.
CLERK_WEBHOOK_SIGNING_SECRET=""
CLERK_WEBHOOK_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/app"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/app"

# Application. Set this to the deployed Vercel URL in hosted environments.
APP_URL="http://localhost:3000"

# Optional protected event-status reconciliation. Leave blank while no Vercel
# Cron schedule is configured.
CRON_SECRET=""

# Deferred: Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Deferred: Stream Chat
NEXT_PUBLIC_STREAM_API_KEY=""
STREAM_API_SECRET=""

# Deferred: PostHog
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# Deferred: Upstash Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
